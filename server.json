{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.opentickers/opentickers",
  "title": "OpenTickers",
  "description": "Central bank exchange rates and financial indicators via the OpenTickers API.",
  "version": "1.0.0",
  "websiteUrl": "https://opentickers.com",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/OpenTickers/opentickers-mcp/main/assets/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "repository": {
    "url": "https://github.com/OpenTickers/opentickers-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.opentickers.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer authentication header for the OpenTickers API",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "Your OpenTickers API key (create one at https://opentickers.com)",
              "isRequired": true,
              "isSecret": true,
              "placeholder": "ot_..."
            }
          }
        }
      ]
    }
  ]
}
